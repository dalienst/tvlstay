# Postgres. Neon while testing, Railway once deployed.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Optional. The general QR code opens this property's guide directly (e.g. village).
# Leave empty to show a list of properties instead.
DEFAULT_PROPERTY=village

# Public address of the guide, used by `npm run rooms` when it draws QR codes,
# e.g. https://stay.tamarind.co.ke. Defaults to http://localhost:3000.
APP_URL=

# Signs staff sessions for the admin panel (/admin). Required: a long random string,
# e.g. run `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`.
SESSION_SECRET=

# Email (Resend, https://resend.com) for STAFF alerts and password reset links only; guests
# are never emailed. Verify your domain in Resend first. Leave empty to switch email off:
# requests still appear in the admin's Requests page.
RESEND_API_KEY=
EMAIL_FROM="Tamarind Guest Guide <guide@tamarind.co.ke>"
